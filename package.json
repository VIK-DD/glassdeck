{
  "name": "glassdeck",
  "private": true,
  "version": "0.1.0",
  "description": "Turn an old Android phone into a CarPlay-style touch deck for your Windows PC",
  "license": "MIT",
  "author": "VIK-DD",
  "repository": "github:VIK-DD/glassdeck",
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "dev": "vite",
    "electron:compile": "tsc -p tsconfig.electron.json",
    "desktop:dev": "npm run electron:compile && electron . --dev",
    "desktop": "npm run build && electron .",
    "build": "tsc && npm run electron:compile && vite build",
    "typecheck": "tsc",
    "test": "vitest run"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^44.9.2",
    "typescript": "~5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
